# ---------------------------------------------------------------------------
# Google Sheets  (leave everything below blank to run on local JSON storage)
# ---------------------------------------------------------------------------
# Setup, once:
# 1. Google Cloud Console -> create a project -> enable the "Google Sheets API"
# 2. IAM & Admin -> Service Accounts -> create one -> Keys -> Add key -> JSON
# 3. Open your Google Sheet -> Share -> add the service account's client_email
#    as an *Editor*.  (Most "403 permission denied" problems are this step.)

# The spreadsheet id is the long string between /d/ and /edit:
#   docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit#gid=170384010
#                                  ^------------------ this ------------------^      ^ NOT this ^
# (the number after #gid= is a tab id, not the spreadsheet id)
GOOGLE_SHEET_ID=

# --- Credentials: pick ONE of the two options below ------------------------

# OPTION A — service-account JSON key file (easiest for local development)
# Drop the file Google gave you in the project root as service-account.json and
# you are done; nothing else here needs setting. It is gitignored.
# To keep it elsewhere, or to reuse one you already have, point at it:
# GOOGLE_SERVICE_ACCOUNT_FILE=../lgf-automation/service-account.json
#
# OPTION B — environment variables (use this on Vercel and other hosts, where
# there is no filesystem to put a key file on). Copy client_email and
# private_key out of that same JSON file. Keep the quotes and the literal \n.
# These take precedence over the file if both are present.
GOOGLE_SERVICE_ACCOUNT_EMAIL=lgf-bot@lgf-automation.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDnBiDLXxM/O7mB\nAbxMayehmpobamDvMoZmBp+tIjT2mQZxt7IbZRQrpNeHG+8h0rP5+tdN3uszkUZF\nZWmh52ZcVUX8UcIO70NDAQK21jLB15Zqn4a5C1pKkQz+6ksmx+I7BGnoqFWIpsmh\n4REc90kUsB6k4Sofiih9OJXut4LdVYpI8eG9WR5KuWDh7I+nloSk++2ifBQ1m4RI\niLEtm0EN1lmAysKlZD2c13bWLsCGwwgewFrDjNEpQJGpllMGt+RoNRG2725Y3pBB\nmh5DYxg2UQkUU1so6dxs2N0BgmTv2Jo02iszXm7IYkwIWrsFoc/rQb5hkbCs7JPj\nrU39EiOFAgMBAAECggEAAPYxqz11x5u08GyOICAOH++t3OvWxeQFT1kaT4wCPDuz\nun51SAS9zJjEtweYyDLnyUN0lOA31254V4Q2V75wIDtFjpUBobKnw/s5mHtV7ZV5\nb2D2bOFfdfo0Dr742bcmIBkGei67m55u7Gnx9tIPvEMgKwRP9xspBsJ59PX/CDEz\n+1iyXX5aO7UeP7NfVhEFNKNDp9UAy5x/KABvptuAODUAT3Py3dm8aJ90NvDyoG35\nQWt7WoikWLyfuYGBBFnL94B78zvOsa+/tgw4LQkbRqYCoR+5gPlpTJa936BR4Zmd\n2UdlFXi+uVZHf0o4+V5Xs7lWwJEZLPL1s6eJ5eR18QKBgQD/65ahhwHeM5qlFVdh\nHMcCEoyyZ+pmxoUmE1QTk4JM8g+KfRGQ6IAEVSah8goYE2VhTsNPtTt2kPzGqeDi\nHd/59QHQ9KB1QnRnWzSRqgY+Ogo6bWoANk7Q9V4kKLOADY9fPzMJpSMhiJs/pe7i\nlvDbY46QXzJt11tda8s4vVbF+QKBgQDnGI3UzhyhgOtutveKriJM2zaIjb9FEu8K\nZlRZal2Yux5h2FQuSx5mjEe9UN5FOC5s69mEcG9VQKmPwopjhRvgmTJK50sPOa8N\nMcygdEluDGOiyOWTZfGPdGJ3kQ5cYuzBXWU2Uy5lh4vRk+UW5VNOk+MZWLHWfSBf\nkZ+cW6q87QKBgB0Ckqeqyy5qARy3h5ktju2QNry+hNazqEJBrKUvcnTQd6yGMuiP\nQnu7P07aRgSmpjZanE87xwrQsqa+eQyIwGvwNw19vXatWs6gixv7/wssvx4SaxKt\nFVAgkFRe/MIGR3tPibSNMKdLefXEFIlA/PqRlYaOFARZhjTX1EiRRfXZAoGAVMtW\np2HlcYErYdly5QjV/xtkXCCesQqseUVo59I2e6cVE9Pbt4zKn9gTLqzwkbd2mXLE\nwmq6/y4VyXEZdEDQJM4xfPh3OyPwTkgajDl/BAk5ue47BqWeSAPtaW/pNA78Tksl\nqxREbu6YaBL7OTZ2JdvvtUotHsWUzlxRk36zHFUCgYEAn4Q5tBfdbriqFcVwoDF9\nEkRRf/F9od7mmWBD7D+GaL99pVfTmzHlBpFTyuo4aF4WOvBRSdZdquq+zW6yw1ab\nYFxU74NcnhA2EEQyDqR1/ggPpuQc0kX1V0tToEorEOKhcQOIbt8VkIsPqlNde9J2\nZYLb9kuFyN881JjGddWv++I=\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin used when generating shareable affiliate links. Leave blank in
# development and the current request host is used.
NEXT_PUBLIC_BASE_URL=

# Set to false to stop logging landing-page views to the Visits tab.
TRACK_VISITS=true

# ---------------------------------------------------------------------------
# Admin protection
# ---------------------------------------------------------------------------
# The dashboard shows lead names, emails and phone numbers. Set a password and
# the dashboard, the links pages and /api/links require HTTP Basic auth.
# Landing pages and form submissions stay public. A production build with no
# password serves 503 on the admin pages rather than exposing them; set
# ALLOW_OPEN_ADMIN=true to override that deliberately.
ADMIN_PASSWORD=
ADMIN_USER=admin
