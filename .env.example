# ---------------------------------------------------------------------------
# Google Sheets  (leave everything below blank to run on local JSON storage)
# ---------------------------------------------------------------------------
# Setup, once:
# 1. Google Cloud Console -> create a project -> enable the "Google Sheets API"
# 2. IAM & Admin -> Service Accounts -> create one -> Keys -> Add key -> JSON
# 3. Open your Google Sheet -> Share -> add the service account's client_email
#    as an *Editor*.  (Most "403 permission denied" problems are this step.)

# The spreadsheet id is the long string between /d/ and /edit:
#   docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit#gid=170384010
#                                  ^------------------ this ------------------^      ^ NOT this ^
# (the number after #gid= is a tab id, not the spreadsheet id)
GOOGLE_SHEET_ID=

# --- Credentials: pick ONE of the two options below ------------------------

# OPTION A — service-account JSON key file (easiest for local development)
# Drop the file Google gave you in the project root as service-account.json and
# you are done; nothing else here needs setting. It is gitignored.
# To keep it elsewhere, or to reuse one you already have, point at it:
# GOOGLE_SERVICE_ACCOUNT_FILE=../lgf-automation/service-account.json
#
# OPTION B — environment variables (use this on Vercel and other hosts, where
# there is no filesystem to put a key file on). Copy client_email and
# private_key out of that same JSON file. Keep the quotes and the literal \n.
# These take precedence over the file if both are present.
# NEVER put a real key in THIS file — it is committed to the repo.
# Real values go in .env.local (gitignored), or use Option A above.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin used when generating shareable affiliate links. Leave blank in
# development and the current request host is used.
NEXT_PUBLIC_BASE_URL=

# Set to false to stop logging landing-page views to the Visits tab.
TRACK_VISITS=true

# ---------------------------------------------------------------------------
# Admin protection
# ---------------------------------------------------------------------------
# The dashboard shows lead names, emails and phone numbers. Set a password and
# the dashboard, the links pages and /api/links require HTTP Basic auth.
# Landing pages and form submissions stay public. A production build with no
# password serves 503 on the admin pages rather than exposing them; set
# ALLOW_OPEN_ADMIN=true to override that deliberately.
ADMIN_PASSWORD=
ADMIN_USER=admin
