# ---------------------------------------------------------------------------
# Google Sheets (leave all three blank to run on local JSON storage instead)
# ---------------------------------------------------------------------------
# 1. Google Cloud Console -> create a project -> enable the "Google Sheets API"
# 2. IAM & Admin -> Service Accounts -> create one -> Keys -> Add key -> JSON
# 3. Copy client_email and private_key out of that JSON file
# 4. Open your Google Sheet -> Share -> add the client_email as an *Editor*
# 5. The sheet ID is the long id in the URL:
#    docs.google.com/spreadsheets/d/<THIS PART>/edit

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com

# Keep the surrounding quotes and the literal \n sequences exactly as they
# appear in the downloaded JSON key.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin used when generating shareable affiliate links. Leave blank in
# development and the current request host is used.
NEXT_PUBLIC_BASE_URL=

# Set to false to stop logging landing-page views to the Visits tab.
TRACK_VISITS=true

# ---------------------------------------------------------------------------
# Admin protection
# ---------------------------------------------------------------------------
# The dashboard shows lead names, emails and phone numbers. Set a password and
# the dashboard, the links pages and /api/links require HTTP Basic auth.
# Landing pages and form submissions stay public. STRONGLY recommended before
# putting this on a public URL. Leave blank for local development.
ADMIN_PASSWORD=
ADMIN_USER=admin
